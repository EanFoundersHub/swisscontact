{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swisscontact-diagnosticos",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ALLOWED_EMAILS": "paula.osorio@swisscontact.org,lorenzo.ortiz@swisscontact.org,afcaballero@universidadean.edu.co,lapacely@universidadean.edu.co",
    "SESSION_DURATION_HOURS": "12"
  },
  "r2_buckets": [
    { "binding": "REPORTS", "bucket_name": "swisscontact-diagnosticos" }
  ],
  "routes": [
    { "pattern": "diagnosticos.example.org/*", "zone_name": "example.org" }
  ]
}
